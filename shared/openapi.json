          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          },
          "zero_shear_points": {
            "items": {
              "type": "number"
            },
            "title": "Zero Shear Points",
            "type": "array"
          }
