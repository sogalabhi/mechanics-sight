            "maxItems": 100,
            "title": "Loads",
            "type": "array"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "supports": {
            "items": {
              "$ref": "#/components/schemas/SupportIn"
            },
            "maxItems": 20,
            "minItems": 1,
            "title": "Supports",
            "type": "array"
          }
        },
        "required": [
          "length",
          "supports"
        ],
        "title": "BeamIn",
        "type": "object"
      },
