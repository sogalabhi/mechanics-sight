          "segments": {
            "items": {
              "$ref": "#/components/schemas/SegmentOut"
            },
            "title": "Segments",
            "type": "array"
          },
          "steps": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/StepOut"
