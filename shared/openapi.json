          "classification",
          "reactions",
          "segments",
          "critical_points",
          "zero_shear_points",
          "extremes",
          "warnings"
        ],
        "title": "AnalysisOut",
        "type": "object"
      },
      "BeamIn": {
        "additionalProperties": false,
        "properties": {
          "length": {
            "description": "m",
            "exclusiveMinimum": 0.0,
            "maximum": 1000.0,
            "title": "Length",
            "type": "number"
          },
          "loads": {
            "items": {
              "discriminator": {
                "mapping": {
                  "distributed": "#/components/schemas/DistributedLoadIn",
                  "moment": "#/components/schemas/PointMomentIn",
                  "point": "#/components/schemas/PointLoadIn"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/components/schemas/PointLoadIn"
                },
                {
                  "$ref": "#/components/schemas/PointMomentIn"
                },
                {
                  "$ref": "#/components/schemas/DistributedLoadIn"
                }
              ]
